  shortDescription: "\u5BF9\u654C\u65B9\u5355\u4F53\u9020\u6210\u5176\u6700\u5927\u751F\u547D\u503C6%\uFF08\u5BF9\u9996\u9886\u4E3A3%\uFF09\u7684\u771F\u5B9E\u4F24\u5BB3\uFF0C\u5E76\u9644\u52A0\u5DE8\u989D\u989D\u5916\u771F\u5B9E\u4F24\u5BB3\u3002\u82E5\u91CA\u653E\u524D\u76EE\u6807\u751F\u547D\u503C\u4F4E\u4E8E30%\uFF08\u5BF9\u9996\u9886\u4E3A15%\uFF09\uFF0C\u5219\u76F4\u63A5\u65A9\u6740\u3002"
