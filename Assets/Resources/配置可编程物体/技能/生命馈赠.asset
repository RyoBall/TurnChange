  m_Name: "\u751F\u547D\u9988\u8D60"
  m_EditorClassIdentifier: 
  skillName: "\u751F\u547D\u9988\u8D60"
  shortDescription: "\u5207\u51FA\u65F6\uFF0C\u6839\u636E\u81EA\u8EAB\u5269\u4F59\u751F\u547D\u503C\u767E\u5206\u6BD4\uFF0C\u4E3A\u4E0B\u4E00\u4E2A\u5207\u5165\u7684\u6211\u65B9\u5355\u4F4D\u65BD\u52A0\u76F8\u5E94\u9988\u8D60\uFF1A\n-
    \u226570%\uFF1A\u83B7\u5F97\u9988\u8D60\xB7\u5F31\u2014\u2014\u9020\u6210\u7684\u4F24\u5BB3\u63D0\u534720%\uFF0C\u6301\u7EED3\u6B21\u884C\u52A8\u3002\n-
    30%~70%\uFF1A\u83B7\u5F97\u9988\u8D60\xB7\u4E2D\u2014\u2014\u9020\u6210\u7684\u4F24\u5BB3\u63D0\u534730%\uFF0C\u884C\u52A8\u540E\u56DE\u590D\u81EA\u8EAB10%\u6700\u5927\u751F\u547D\u503C\uFF0C\u6301\u7EED2\u6B21\u884C\u52A8\u3002\n-
    <30%\uFF1A\u83B7\u5F97\u9988\u8D60\xB7\u5F3A\u2014\u2014\u9020\u6210\u7684\u4F24\u5BB3\u63D0\u534740%\uFF0C\u9996\u6B21\u9020\u6210\u4F24\u5BB3\u65F6\u989D\u5916\u56DE\u590D\u5976\u598820%\u6700\u5927\u751F\u547D\u503C\uFF0C\u6301\u7EED2\u6B21\u884C\u52A8\u3002"
  description: "\u5207\u51FA\u65F6\uFF0C\u6839\u636E\u81EA\u8EAB\u5269\u4F59\u751F\u547D\u503C\u767E\u5206\u6BD4\uFF0C\u4E3A\u4E0B\u4E00\u4E2A\u5207\u5165\u7684\u6211\u65B9\u5355\u4F4D\u65BD\u52A0\u76F8\u5E94\u9988\u8D60\uFF1A\u5927\u4E8E\u7B49\u4E8E70%\u65F6\u83B7\u5F97\u9988\u8D60\xB7\u5F31\uFF0C30%\u523070%\u65F6\u83B7\u5F97\u9988\u8D60\xB7\u4E2D\uFF0C\u5C0F\u4E8E30%\u65F6\u83B7\u5F97\u9988\u8D60\xB7\u5F3A\u3002"
